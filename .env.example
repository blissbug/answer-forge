# Compose / PostgreSQL
POSTGRES_DB=answerforge
POSTGRES_USER=answerforge
POSTGRES_PASSWORD=answerforge-local

# Backend container values use Compose service names, not localhost.
DATABASE_URL=postgresql+psycopg://answerforge:answerforge-local@db:5432/answerforge
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=20

# Gemini provider. Required for embedding uploads and agent generation.
GEMINI_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MAX_RETRIEVAL_ROUNDS=3
AGENT_RETRIEVAL_TOP_K=5
AGENT_WORKER_CONCURRENCY=2

# Browser requests go through Caddy; direct local development remains allowed.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_BASE_URL=http://api:8000
