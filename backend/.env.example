DATABASE_URL=postgresql+psycopg://answerforge:answerforge@localhost:5432/answerforge
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20
GEMINI_API_KEY=
# EMBEDDING_API_KEY is accepted as a backwards-compatible Gemini key alias.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
MAX_RETRIEVAL_ROUNDS=3
AGENT_RETRIEVAL_TOP_K=5
AGENT_WORKER_CONCURRENCY=2
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
